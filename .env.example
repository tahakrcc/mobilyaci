# Neon Postgres (Vercel Marketplace injects DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Vercel Blob (created when Blob storage is connected)
BLOB_READ_WRITE_TOKEN=

# Admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=Wooden Universe

# Optional order email notifications via Resend
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL="WoodenUniverse <orders@example.com>"

# Public site address used in customer tracking links
NEXT_PUBLIC_SITE_URL=https://woodenuniverse.vercel.app
